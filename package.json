{
  "name": "pacs-viewer-workstation",
  "version": "1.0.0",
  "description": "医院PACS桌面阅片工作站",
  "main": "electron/main.js",
  "author": "Hospital Radiology Department",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:electron": "npm run vite:build && electron .",
    "vite:build": "tsc --noEmit && vite build",
    "build": "tsc --noEmit && vite build",
    "electron:serve": "concurrently -k \"npm:dev\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run vite:build && electron-builder",
    "electron:build:win": "npm run vite:build && electron-builder --win --x64",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "antd": "^5.15.0",
    "dayjs": "^1.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.hospital.pacs.viewer",
    "productName": "PACS阅片工作站",
    "copyright": "Copyright © 2024 Hospital Radiology",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-${os}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PACS阅片工作站"
    }
  }
}
